{
    "Declaration": {
        "prefix": ["def"],
        "body": ["(def ${1:name} ${0:value})"],
        "description": "Hoisted immutable declaration"
    },
    "Function definition": {
        "prefix": ["defn", "deff", "def-fn"],
        "body": [
            "(def ${1:name} (Func [${2:params}]",
            "\t$0",
            "))"
        ],
        "description": "Top-level function definition"
    },
    "Public function definition": {
        "prefix": ["pub", "pubfn"],
        "body": [
            "#pub",
            "(def ${1:name} (Func [${2:params}]",
            "\t$0",
            "))"
        ],
        "description": "Public function definition with stacked #pub annotation"
    },
    "Struct definition": {
        "prefix": ["struct"],
        "body": [
            "(def ${1:Name} (Struct",
            "\t${2:#String field}",
            "))",
            "(derive ${1:Name} Eq Clone)"
        ],
        "description": "Struct type definition with derive"
    },
    "Pattern matching (when)": {
        "prefix": ["when"],
        "body": [
            "(when ${1:subject}",
            "\t${2:pattern} ${3:result}",
            "\t_ ${0:default}",
            ")"
        ],
        "description": "Pattern matching expression"
    },
    "If-Else": {
        "prefix": ["ife", "if-else"],
        "body": [
            "(if ${1:predicate}",
            "\t$2",
            "(else",
            "\t$3",
            "))"
        ],
        "description": "If-else conditional expression"
    },
    "Sequence comprehension (for->seq)": {
        "prefix": ["forseq", "for-seq"],
        "body": [
            "(for->seq [${1:item} ${2:items}]",
            "\t$0",
            ")"
        ],
        "description": "Sequence comprehension building an array or tree"
    },
    "Use statement": {
        "prefix": ["use"],
        "body": ["(use {${2:names}} ${1:/module})"],
        "description": "Module import statement"
    },
    "Say": {
        "prefix": ["say"],
        "body": ["(say \"${0}\")"],
        "description": "Print formatted output with say"
    },
    "HTML Component": {
        "prefix": ["shtml", "def-html"],
        "body": [
            "#pub",
            "(def <${1:component}> (Func [...children]",
            "\t#shtml [:div$0",
            "\t\t...children",
            "\t]",
            "))"
        ],
        "description": "Idiomatic #shtml component definition"
    },
    "Local fallback (ok-or)": {
        "prefix": ["okor", "ok-or"],
        "body": ["(ok-or ${1:expr} ${0:default})"],
        "description": "Local fallback on () or Error"
    },
    "Module/file doc comment": {
        "prefix": ["doc"],
        "body": ["#(doc \"\"\"\n${0}\n\"\"\") %file"],
        "description": "Structured documentation attachment"
    }
}
