{
    "comments": {
        "lineComment": ";"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "autoCloseBefore": ";:.,=}])>` \n\t",
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*;\\s*#?region\\b",
            "end": "^\\s*;\\s*#?endregion\\b"
        }
    },
    "wordPattern": "(-?\\d[\\d_]*\\.\\d[\\d_a-zA-Z]*|<[a-zA-Z][a-zA-Z0-9_-]*>|\\*[a-zA-Z0-9_-]+\\*|%[a-zA-Z0-9_-]+|(?:->|<-|[a-zA-Z0-9_-])+(?:[?!](?![a-zA-Z0-9_-]))?)",
    "indentationRules": {
        "increaseIndentPattern": "^((?!;).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
        "decreaseIndentPattern": "^\\s*[\\}\\]\\)]"
    }
}
