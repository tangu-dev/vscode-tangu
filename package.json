{
    "name": "vscode-tangu",
    "displayName": "Tangu",
    "description": "Visual Studio Code extension for the Tangu programming language — LSP, Test Explorer, REPL, inline eval, and live compiler previews.",
    "author": "George Moschovitis",
    "license": "MPL-2.0",
    "version": "0.40.0",
    "icon": "images/icon.png",
    "homepage": "https://tangu.dev",
    "bugs": {
        "url": "https://github.com/tangu-dev/vscode-tangu/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tangu-dev/vscode-tangu"
    },
    "publisher": "tangu-dev",
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters",
        "Snippets",
        "Testing"
    ],
    "keywords": [
        "tangu",
        "lisp",
        "s-expression",
        "lsp",
        "language-server"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Syntax highlighting, snippets, structural editing, and user-configured LSP features work in Restricted Mode. Running Tangu files, tests, REPL/eval, macro/IR previews, CLI fix/doctor, and workspace-level binary/env/config overrides requires a trusted workspace."
        }
    },
    "engines": {
        "vscode": "^1.99.0"
    },
    "main": "./dist/main.js",
    "activationEvents": [
        "workspaceContains:manifest.data.tan",
        "workspaceContains:.tangu/config.data.tan"
    ],
    "contributes": {
        "languages": [
            {
                "id": "tangu",
                "extensions": [
                    ".tan"
                ],
                "aliases": [
                    "Tangu",
                    "Tangu Language"
                ],
                "icon": {
                    "light": "./icons/light/code.svg",
                    "dark": "./icons/dark/code.svg"
                },
                "filenames": [],
                "firstLine": "^#!/.*\\btangu[0-9.-]*\\b",
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-data",
                "extensions": [
                    ".data.tan"
                ],
                "aliases": [
                    "Tangu Data"
                ],
                "icon": {
                    "light": "./icons/light/data.svg",
                    "dark": "./icons/dark/data.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-test",
                "extensions": [
                    ".test.tan"
                ],
                "aliases": [
                    "Tangu Test"
                ],
                "icon": {
                    "light": "./icons/light/test.svg",
                    "dark": "./icons/dark/test.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-schema",
                "extensions": [
                    ".schema.tan"
                ],
                "aliases": [
                    "Tangu Schema"
                ],
                "icon": {
                    "light": "./icons/light/schema.svg",
                    "dark": "./icons/dark/schema.svg"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tangu",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown",
                    "meta.embedded.inline.sql": "sql",
                    "meta.embedded.inline.html": "html"
                }
            },
            {
                "language": "tangu-data",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown",
                    "meta.embedded.inline.sql": "sql",
                    "meta.embedded.inline.html": "html"
                }
            },
            {
                "language": "tangu-test",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown",
                    "meta.embedded.inline.sql": "sql",
                    "meta.embedded.inline.html": "html"
                }
            },
            {
                "language": "tangu-schema",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown",
                    "meta.embedded.inline.sql": "sql",
                    "meta.embedded.inline.html": "html"
                }
            },
            {
                "scopeName": "markdown.tangu.codeblock",
                "path": "./syntaxes/tangu.codeblock.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.tangu": "tangu"
                }
            }
        ],
        "commands": [
            {
                "command": "tangu.openREPL",
                "title": "Open REPL Terminal",
                "category": "Tangu"
            },
            {
                "command": "tangu.sendSelectionToREPL",
                "title": "Send Selection to REPL",
                "category": "Tangu"
            },
            {
                "command": "tangu.sendFormToREPL",
                "title": "Send Top-Level Form to REPL",
                "category": "Tangu"
            },
            {
                "command": "tangu.sendFileToREPL",
                "title": "Send Current File to REPL",
                "category": "Tangu"
            },
            {
                "command": "tangu.evalSelectionOrForm",
                "title": "Evaluate Selection or Form",
                "category": "Tangu"
            },
            {
                "command": "tangu.evalExpressionPrompt",
                "title": "Evaluate Expression...",
                "category": "Tangu"
            },
            {
                "command": "tangu.clearEvalResults",
                "title": "Clear Inline Evaluation Results",
                "category": "Tangu"
            },
            {
                "command": "tangu.expandMacro",
                "title": "Expand Macro at Cursor",
                "category": "Tangu",
                "icon": "$(symbol-misc)"
            },
            {
                "command": "tangu.expandMacroStep",
                "title": "Expand Macro at Cursor (Single Step)",
                "category": "Tangu"
            },
            {
                "command": "tangu.syntaxTree",
                "title": "Show Syntax Tree",
                "category": "Tangu"
            },
            {
                "command": "tangu.showDelimiters",
                "title": "Show Delimiter Balance & Depth",
                "category": "Tangu"
            },
            {
                "command": "tangu.showCompiledJs",
                "title": "Show Transpiled JavaScript",
                "category": "Tangu"
            },
            {
                "command": "tangu.showTir",
                "title": "Show Typed IR (TIR)",
                "category": "Tangu"
            },
            {
                "command": "tangu.showClif",
                "title": "Show Cranelift IR (CLIF)",
                "category": "Tangu"
            },
            {
                "command": "tangu.requestFullWorkspaceDiagnostics",
                "title": "Run Full Workspace Diagnostics",
                "category": "Tangu"
            },
            {
                "command": "tangu.restartServer",
                "title": "Restart Language Server",
                "category": "Tangu"
            },
            {
                "command": "tangu.openServerLogs",
                "title": "Open Language Server Logs",
                "category": "Tangu"
            },
            {
                "command": "tangu.showStatusMenu",
                "title": "Show Language Server Menu",
                "category": "Tangu"
            },
            {
                "command": "tangu.runFix",
                "title": "Fix & Format Current File (Auto-Import)",
                "category": "Tangu",
                "icon": "$(sparkle)"
            },
            {
                "command": "tangu.runDoctor",
                "title": "Run Environment Doctor",
                "category": "Tangu"
            },
            {
                "command": "tangu.runFile",
                "title": "Run Current File",
                "category": "Tangu",
                "icon": "$(play)"
            },
            {
                "command": "tangu.runTestInExplorer",
                "title": "Run Test in Explorer",
                "category": "Tangu"
            },
            {
                "command": "tangu.runChangedTests",
                "title": "Run Changed Tests",
                "category": "Tangu"
            },
            {
                "command": "tangu.wrapParens",
                "title": "Wrap Form with ()",
                "category": "Tangu"
            },
            {
                "command": "tangu.wrapBrackets",
                "title": "Wrap Form with []",
                "category": "Tangu"
            },
            {
                "command": "tangu.wrapBraces",
                "title": "Wrap Form with {}",
                "category": "Tangu"
            },
            {
                "command": "tangu.slurpForward",
                "title": "Slurp Next Form Forward",
                "category": "Tangu"
            },
            {
                "command": "tangu.barfForward",
                "title": "Barf Last Form Forward",
                "category": "Tangu"
            },
            {
                "command": "tangu.spliceForm",
                "title": "Splice (Unwrap) Enclosing Form",
                "category": "Tangu"
            },
            {
                "command": "tangu.raiseForm",
                "title": "Raise Form at Cursor",
                "category": "Tangu"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "tangu.runTestInExplorer",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "tangu.runFile",
                    "when": "editorLangId == tangu && resourceScheme == file",
                    "group": "navigation"
                },
                {
                    "command": "tangu.runFix",
                    "when": "editorLangId =~ /^tangu/ && resourceScheme == file",
                    "group": "tangu@1"
                },
                {
                    "command": "tangu.evalSelectionOrForm",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@2"
                },
                {
                    "command": "tangu.expandMacro",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@3"
                },
                {
                    "command": "tangu.syntaxTree",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@4"
                },
                {
                    "command": "tangu.showDelimiters",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@5"
                }
            ],
            "editor/context": [
                {
                    "command": "tangu.evalSelectionOrForm",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@1"
                },
                {
                    "command": "tangu.sendFormToREPL",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@2"
                },
                {
                    "command": "tangu.sendSelectionToREPL",
                    "when": "editorHasSelection && editorLangId =~ /^tangu/",
                    "group": "tangu@3"
                },
                {
                    "command": "tangu.expandMacro",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@4"
                },
                {
                    "command": "tangu.expandMacroStep",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@5"
                },
                {
                    "command": "tangu.syntaxTree",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@6"
                },
                {
                    "command": "tangu.showDelimiters",
                    "when": "editorLangId =~ /^tangu/",
                    "group": "tangu@7"
                },
                {
                    "command": "tangu.runFix",
                    "when": "resourceScheme == file && editorLangId =~ /^tangu/",
                    "group": "tangu@8"
                }
            ]
        },
        "keybindings": [
            {
                "command": "tangu.evalSelectionOrForm",
                "key": "ctrl+alt+t e",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.sendFormToREPL",
                "key": "ctrl+alt+t r",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.expandMacro",
                "key": "ctrl+alt+t m",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.showDelimiters",
                "key": "ctrl+alt+t d",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.syntaxTree",
                "key": "ctrl+alt+t a",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.runFix",
                "key": "ctrl+alt+t f",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.wrapParens",
                "key": "ctrl+alt+t (",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.wrapBrackets",
                "key": "ctrl+alt+t [",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.wrapBraces",
                "key": "ctrl+alt+t {",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.slurpForward",
                "key": "ctrl+alt+t right",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.barfForward",
                "key": "ctrl+alt+t left",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.spliceForm",
                "key": "ctrl+alt+t s",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            },
            {
                "command": "tangu.raiseForm",
                "key": "ctrl+alt+t u",
                "when": "editorTextFocus && editorLangId =~ /^tangu/"
            }
        ],
        "snippets": [
            {
                "language": "tangu",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-data",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-schema",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-test",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-test",
                "path": "./snippets-test.json"
            }
        ],
        "taskDefinitions": [
            {
                "type": "tangu",
                "required": [
                    "command"
                ],
                "properties": {
                    "command": {
                        "type": "string",
                        "enum": [
                            "check",
                            "test",
                            "fix",
                            "run",
                            "compile",
                            "bench"
                        ],
                        "description": "The tangu CLI subcommand to execute."
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Additional arguments passed to the tangu CLI subcommand."
                    }
                }
            }
        ],
        "problemMatchers": [
            {
                "name": "tangu",
                "label": "Tangu compiler & linter",
                "owner": "tangu-cli",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(Error|Warning|Info|Hint)\\s+\\[([^\\]]+)\\]\\s+(.+?):(\\d+):(\\d+):\\s+(.*)$",
                    "severity": 1,
                    "code": 2,
                    "file": 3,
                    "line": 4,
                    "column": 5,
                    "message": 6
                }
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Tangu",
            "properties": {
                "tangu.server.path": {
                    "scope": "window",
                    "type": "string",
                    "default": "",
                    "restricted": true,
                    "description": "Optional path to the tangu-language-server executable. When empty, searches PATH, ~/.cargo/bin, and $TANGU_ROOT/bin."
                },
                "tangu.server.extraEnv": {
                    "scope": "window",
                    "type": "object",
                    "default": {},
                    "restricted": true,
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Additional environment variables passed to the tangu-language-server process."
                },
                "tangu.server.logLevel": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "",
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                    ],
                    "default": "",
                    "description": "Optional RUST_LOG directive for tangu-language-server. Leave empty to let tangu.trace.server control log verbosity dynamically."
                },
                "tangu.cli.path": {
                    "scope": "window",
                    "type": "string",
                    "default": "",
                    "restricted": true,
                    "description": "Optional path to the tangu CLI executable. When empty, searches PATH, ~/.cargo/bin, and $TANGU_ROOT/bin."
                },
                "tangu.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language server."
                },
                "tangu.diagnostics.workspace": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Enable workspace-wide diagnostics in tangu-language-server. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.lint.enable": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Lint rules or categories to enable. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.lint.disable": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Lint rules or categories to disable. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.lint.exclude": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "File or directory globs excluded from linting. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.lint.severity": {
                    "scope": "resource",
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "string",
                        "enum": [
                            "error",
                            "warning",
                            "info",
                            "hint",
                            "off"
                        ]
                    },
                    "description": "Per-rule lint severity overrides. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.format.indentSize": {
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 1,
                    "default": 4,
                    "description": "Formatter indentation width in spaces. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.format.softLineLimit": {
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 1,
                    "default": 80,
                    "description": "Formatter soft line wrap limit. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.format.hardLineLimit": {
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 1,
                    "default": 120,
                    "description": "Formatter hard line wrap limit. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.format.organizeImports": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically sort and organize imports when formatting. Overrides .tangu/config.data.tan only when explicitly modified."
                },
                "tangu.eval.timeoutMs": {
                    "scope": "window",
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 30000,
                    "default": 5000,
                    "description": "Timeout in milliseconds for inline expression evaluation."
                },
                "tangu.codeLens.runTest": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "description": "Show 'Run test' / 'Run all tests in file' CodeLenses in .test.tan files (disable if you only want Test Explorer gutter icons)."
                }
            }
        },
        "semanticTokenModifiers": [
            {
                "id": "effectful",
                "description": "Functions or expressions with side effects"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "tangu",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-data",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-test",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-schema",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "[tangu]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on",
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": "active"
            },
            "[tangu-data]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on",
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": "active"
            },
            "[tangu-test]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on",
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": "active"
            },
            "[tangu-schema]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on",
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": "active"
            },
            "editor.semanticTokenColorCustomizations": {
                "[*]": {
                    "rules": {
                        "interface:tangu": {
                            "fontStyle": "",
                            "foreground": "#7A8CA5"
                        },
                        "interface:tangu-data": {
                            "fontStyle": "",
                            "foreground": "#7A8CA5"
                        },
                        "interface:tangu-test": {
                            "fontStyle": "",
                            "foreground": "#7A8CA5"
                        },
                        "interface:tangu-schema": {
                            "fontStyle": "",
                            "foreground": "#7A8CA5"
                        },
                        "type:tangu": {
                            "fontStyle": ""
                        },
                        "type:tangu-data": {
                            "fontStyle": ""
                        },
                        "type:tangu-test": {
                            "fontStyle": ""
                        },
                        "type:tangu-schema": {
                            "fontStyle": ""
                        },
                        "class:tangu": {
                            "fontStyle": ""
                        },
                        "class:tangu-data": {
                            "fontStyle": ""
                        },
                        "class:tangu-test": {
                            "fontStyle": ""
                        },
                        "class:tangu-schema": {
                            "fontStyle": ""
                        },
                        "struct:tangu": {
                            "fontStyle": ""
                        },
                        "struct:tangu-data": {
                            "fontStyle": ""
                        },
                        "struct:tangu-test": {
                            "fontStyle": ""
                        },
                        "struct:tangu-schema": {
                            "fontStyle": ""
                        },
                        "enum:tangu": {
                            "fontStyle": ""
                        },
                        "enum:tangu-data": {
                            "fontStyle": ""
                        },
                        "enum:tangu-test": {
                            "fontStyle": ""
                        },
                        "enum:tangu-schema": {
                            "fontStyle": ""
                        },
                        "*.modification:tangu": {
                            "fontStyle": "underline"
                        },
                        "*.modification:tangu-data": {
                            "fontStyle": "underline"
                        },
                        "*.modification:tangu-test": {
                            "fontStyle": "underline"
                        },
                        "*.modification:tangu-schema": {
                            "fontStyle": "underline"
                        },
                        "*.effectful:tangu": {
                            "fontStyle": "italic"
                        },
                        "*.effectful:tangu-data": {
                            "fontStyle": "italic"
                        },
                        "*.effectful:tangu-test": {
                            "fontStyle": "italic"
                        },
                        "*.effectful:tangu-schema": {
                            "fontStyle": "italic"
                        },
                        "*.deprecated:tangu": {
                            "fontStyle": "strikethrough"
                        },
                        "*.deprecated:tangu-data": {
                            "fontStyle": "strikethrough"
                        },
                        "*.deprecated:tangu-test": {
                            "fontStyle": "strikethrough"
                        },
                        "*.deprecated:tangu-schema": {
                            "fontStyle": "strikethrough"
                        }
                    }
                }
            }
        }
    },
    "scripts": {
