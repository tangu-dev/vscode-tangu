{
    "name": "vscode-tangu",
    "displayName": "Tangu",
    "description": "VSCode Extension for the Tangu language.",
    "author": "George Moschovitis",
    "license": "MPL-2.0",
    "version": "0.39.0",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/tangu-dev/vscode-tangu"
    },
    "publisher": "tangu-dev",
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "tangu"
    ],
    "engines": {
        "vscode": "^1.99.0"
    },
    "main": "./dist/main.js",
    "activationEvents": [
        "workspaceContains:**/*.tan"
    ],
    "contributes": {
        "languages": [
            {
                "id": "tangu",
                "extensions": [
                    ".tan"
                ],
                "aliases": [
                    "Tangu",
                    "Tangu Language"
                ],
                "icon": {
                    "light": "./icons/light/code.svg",
                    "dark": "./icons/dark/code.svg"
                },
                "filenames": [],
                "firstLine": "^#!/.*\\btangu[0-9.-]*\\b",
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-data",
                "extensions": [
                    ".data.tan"
                ],
                "aliases": [
                    "Tangu Data"
                ],
                "icon": {
                    "light": "./icons/light/data.svg",
                    "dark": "./icons/dark/data.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-test",
                "extensions": [
                    ".test.tan"
                ],
                "aliases": [
                    "Tangu Test"
                ],
                "icon": {
                    "light": "./icons/light/test.svg",
                    "dark": "./icons/dark/test.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "tangu-schema",
                "extensions": [
                    ".schema.tan"
                ],
                "aliases": [
                    "Tangu Schema"
                ],
                "icon": {
                    "light": "./icons/light/schema.svg",
                    "dark": "./icons/dark/schema.svg"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tangu",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown"
                }
            },
            {
                "language": "tangu-data",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown"
                }
            },
            {
                "language": "tangu-test",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown"
                }
            },
            {
                "language": "tangu-schema",
                "scopeName": "source.tangu",
                "path": "./syntaxes/tangu.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.comment": "markdown"
                }
            },
            {
                "scopeName": "markdown.tangu.codeblock",
                "path": "./syntaxes/tangu.codeblock.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.tangu": "tangu"
                }
            }
        ],
        "commands": [
            {
                "command": "tangu.syntaxTree",
                "title": "Show Syntax Tree",
                "category": "Tangu"
            },
            {
                "command": "tangu.expandMacro",
                "title": "Expand Macro at Cursor",
                "category": "Tangu"
            },
            {
                "command": "tangu.openREPL",
                "title": "Open a REPL terminal",
                "category": "Tangu"
            },
            {
                "command": "tangu.requestFullWorkspaceDiagnostics",
                "title": "Run Full Workspace Diagnostics",
                "category": "Tangu"
            }
        ],
        "snippets": [
            {
                "language": "tangu",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-data",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-test",
                "path": "./snippets.json"
            },
            {
                "language": "tangu-schema",
                "path": "./snippets.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Tangu Language Server configuration",
            "properties": {
                "tangu.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "tangu.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "verbose",
                    "description": "Traces the communication between VS Code and the language server."
                }
            }
        },
        "semanticTokenScopes": [
            {
                "language": "tangu",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-data",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-test",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            },
            {
                "language": "tangu-schema",
                "scopes": {
                    "variable.modification": [
                        "variable.other.mutable.tangu"
                    ],
                    "interface": [
                        "entity.name.type.interface.tangu"
                    ],
                    "*.effectful": [
                        "entity.name.effectful.tangu"
                    ],
                    "decorator": [
                        "entity.name.tag.tangu"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "[tangu]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on"
            },
            "[tangu-data]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on"
            },
            "[tangu-test]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on"
            },
            "[tangu-schema]": {
                "editor.semanticHighlighting.enabled": true,
                "editor.inlayHints.enabled": "on"
            },
            "editor.semanticTokenColorCustomizations": {
                "[*]": {
                    "rules": {
                        "interface": {
                            "fontStyle": "",
                            "foreground": "#7A8CA5"
                        },
                        "type": {
                            "fontStyle": ""
                        },
                        "class": {
                            "fontStyle": ""
                        },
                        "struct": {
                            "fontStyle": ""
                        },
                        "enum": {
                            "fontStyle": ""
                        },
                        "*.modification": {
                            "fontStyle": "underline"
                        },
                        "*.effectful": {
                            "fontStyle": "italic"
                        },
                        "*.deprecated": {
                            "fontStyle": "strikethrough"
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "compile": "node ./esbuild.js",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "package": "vsce package",
        "publish": "vsce publish",
        "vscode:prepublish": "npm run esbuild-base -- --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/main.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver": "^9.0.1"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.19.19",
        "@types/vscode": "^1.99.0",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "@vscode/codicons": "^0.0.45",
        "@vscode/vsce": "^3.9.1",
        "esbuild": "^0.28.0",
        "eslint": "^8.57.1",
        "glob": "^11.1.0",
        "mocha": "^11.7.6",
        "ts-loader": "^9.5.7",
        "typescript": "^5.9.3",
        "webpack": "^5.107.0",
        "webpack-cli": "^7.0.2"
    }
}
